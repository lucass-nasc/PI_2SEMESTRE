# Copie para .env somente se ainda não tiver seu arquivo de configuração.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saps
PORT=3000
# Opcional no projeto local: sem valor, o servidor gera um segredo ao iniciar.
SESSION_SECRET=
COOKIE_SECURE=false
# Defina antes de executar npm run cadastrar-usuario. Não publique essa senha.
SAPS_SENHA_INICIAL=
