# Copie para .env somente se ainda não tiver seu arquivo de configuração.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saps
PORT=3000
APP_URL=http://127.0.0.1:3000
# Opcional no projeto local: sem valor, o servidor gera um segredo ao iniciar.
SESSION_SECRET=
COOKIE_SECURE=false
# Defina antes de executar npm run cadastrar-usuario. Não publique essa senha.
SAPS_SENHA_INICIAL=
# Preencha com os dados do seu provedor para habilitar a recuperação por e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE=
